{
  "name": "filalogger",
  "version": "1.0.6",
  "productName": "Filalogger",
  "description": "Filament Diameter Logger",
  "author": "Nathik Azad",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "electron": "electron .",
    "build": "tsc",
    "watch": "tsc -w",
    "pack": "electron-builder --dir",
    "dist-mac": "electron-builder --mac",
    "dist": "tsc && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "electron": "^29.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/serialport": "^8.0.5",
    "chart.js": "^4.4.7",
    "serialport": "^13.0.0",
    "usb": "^2.11.0"
  },
  "build": {
    "appId": "com.filalogger.app",
    "productName": "FilaLogger",
    "directories": {
      "output": "release",
      "buildResources": "dist"
    },
    "mac": {
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "files": [
      "**/*",
      "dist/**/*",
      "!.github",
      "!.vs",
      "!node_modules/*"
    ],
    "icon": "icon.png"
  }
}
